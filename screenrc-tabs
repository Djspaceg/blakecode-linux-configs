# screenrc-tabs (global fallback)
#
# This file exists as a fallback if a machine-specific screenrc-tabs doesn't exist.
# Machine-specific screenrc files should source their own screenrc-tabs:
#   source "${MACHINECONFIGDIR}/screenrc-tabs"
#
# If you're seeing this message, create a screenrc-tabs in your machine config folder.

echo "WARNING: Using global screenrc-tabs fallback. Create ${MACHINECONFIGDIR}/screenrc-tabs for machine-specific tabs."

# Default: just create a single window
screen -t 0
chdir $HOME
screen -t General 1
select 1
