# Lazy-load aws-federate: only sources the file on first `federate` call
# (the function needs `source` to export env vars into the current shell,
#  but there's no reason to parse it at shell startup)
federate() {
    unfunction federate  # remove this stub
    source ~/.aws/aws-federate.sh
    federate "$@"        # call the real function
}

buildcdk() {
    echo " -------------------------------------------------------------------";
    echo "   Releasing using stack: $1";
    echo "   Using account ID: $AWS_ACCOUNT_ID";
    echo " -------------------------------------------------------------------";
    brazil-build release;

    # Continue only if successful
    if [ $? -eq 0 ]; then
        echo "";
        echo " -------------------------------------------------------------------";
        echo "   Deploying Assets with: $1";
        echo " -------------------------------------------------------------------";
        brazil-build deploy:assets $1;

        # Continue only if successful
        if [ $? -eq 0 ]; then
            echo "";
            echo " -------------------------------------------------------------------";
            echo "   Deploying CDK with: $1";
            echo " -------------------------------------------------------------------";
            brazil-build cdk deploy $1;
        fi
    fi
}

bootstrapcdk() {
    [ -s "$HOME/.profileconfig/scripts/cdk-bootstrap.sh" ] && . "$HOME/.profileconfig/scripts/cdk-bootstrap.sh"  # Execute this script
}

alias getstacks='brazil-build cdk ls'
alias getuserstack='brazil-build cdk ls | grep BONESBootstrap-${USER}'

