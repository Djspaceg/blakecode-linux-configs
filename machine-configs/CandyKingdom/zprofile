# CandyKingdom/zprofile
#
# Machine-specific login shell configuration
# Runs for LOGIN shells only
#

echo "Running $HOSTNAME/zprofile"

##############################################################################

# Standard macOS paths (append to avoid shadowing machine-specific paths)
export PATH="$PATH:/usr/local/bin"

# Homebrew environment (hardcoded to avoid slow `brew shellenv` subprocess)
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"

# To link Rubies to Homebrew's OpenSSL 1.1 (hardcoded to avoid slow `brew --prefix` subprocess)
export RUBY_CONFIGURE_OPTS="--with-openssl-dir=/opt/homebrew/opt/openssl@1.1"
