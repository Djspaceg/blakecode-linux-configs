# CandyKingdom/screenrc-tabs
#
# Screen status bar customization (caption + hardstatus)
# This file is sourced by Screen's config parser, NOT a shell.
# Only Screen commands are valid here (no shell variables, no tput, no $()).
#
# Color reference for Screen's %{...} escapes:
#   Lowercase = dim, Uppercase = bright
#   k=black r=red g=green y=yellow b=blue m=magenta c=cyan w=white d=default
#   Prefix: = (reset all), + (add attr), - (undo last), s (standout), b (bold)
#
# See: https://www.gnu.org/software/screen/manual/html_node/String-Escapes.html

# Caption: minimal, only shows on split screens
caption splitonly '%{s YK} '

# Hardstatus: window list with highlighted active tab
# Orange-ish default bg, gray active tab with white text. Designed for iTerm2 status bar.
hardstatus string "%{= Dd} %?%-Lw%?%{-}%{gK} (%{+b W}%n %t%?(%u)%?%{-b}%{+ g}) %{-}%{-}%{-}%{-}%{= Dd}%+Lw "
