# CandyKingdom/zshrc
#
# Interactive shells only. Prompt, aliases, functions, integrations.
#

###########################
### SHARED CORE
###########################

source "$HOME/.profileconfig/shell/core/interactive.zsh"
source "$HOME/.profileconfig/shell/core/aliases.zsh"

###########################
### MODULES
###########################

source "$HOME/.profileconfig/shell/modules/brazil.zsh"
source "$HOME/.profileconfig/shell/modules/aws-federate.zsh"
source "$HOME/.profileconfig/shell/modules/iterm.zsh"

###########################
### MACHINE FUNCTIONS
###########################

# Set terminal window/tab title
set-title() {
    printf '\e]0;%s\a' "$*"
}

ssh() {
    set-title "$*"
    /usr/bin/ssh -2 "$@"
    set-title "$HOST"
}

###########################
### MACHINE ALIASES
###########################

bindkey '^[[13;2u' accept-line  # SHIFT+ENTER sends newline

# Cloud dev machine
alias sshcloud='ssh stepblk-main.aka.corp.amazon.com'

# Authentication
alias auth='mwinit -s --fido2 -f -k ~/.ssh/id_ecdsa.pub'

# Editor
alias e=emacs

# Project directories
alias cdlocke='cd ~/workplace/locke/locke-console/src'
alias cdlily='cd ~/workplace/locke/lily-console/src'
alias cdconsole='cd ~/workplace/locke/locke-console/src/AWSLockeConsole'
alias cdcdk='cd ~/workplace/locke/locke-console/src/AWSLockeConsoleCDK'
alias cdtests='cd ~/workplace/locke/locke-console/src/AWSLockeConsoleTests'
alias cdhalo='cd ~/workplace/halo/halo-lr-app/src/HaloLRApp'

###########################
### MACHINE SETTINGS
###########################

ulimit -n 65536

###########################
### COMPLETIONS (load last)
###########################

source "$HOME/.profileconfig/shell/core/completions.zsh"

# Local bin environment
if [[ -f "$HOME/.local/bin/env" ]]; then
    . "$HOME/.local/bin/env"
fi

# Added by AIM CLI
export PATH="$HOME/.aim/mcp-servers:$PATH"
eval "$(/opt/homebrew/bin/brew shellenv)"
# Set up mise for runtime management
eval "$(mise activate zsh)"

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# Flynn (Project)
alias flynn='brazil-runtime-exec flynn'
source /Users/stepblk/.brazil_completion/zsh_completion
