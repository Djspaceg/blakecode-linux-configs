# screen/machines/CandyKingdom.screenrc
#
# CandyKingdom screen config: core settings + green theme + window layout.
# ~/.screenrc symlinks here.
#

source $HOME/.profileconfig/screen/core.screenrc
source $HOME/.profileconfig/screen/colors/terminal-default.screenrc

###########################
### WINDOW LAYOUT
###########################

screen -t 0

screen -t General     1
stuff "cd $HOME/\012"

screen -t Workplace   2
stuff "cd $HOME/workplace\012"

screen -t Workplace2  3
stuff "cd $HOME/workplace\012"

screen -t Source      4
stuff "cd $HOME/Source\012"

screen -t Source2     5
stuff "cd $HOME/Source\012"

screen -t Tr-App      6
stuff "cd $HOME/Source/transformer-android\012"

screen -t Tr-Chat     7
stuff "cd $HOME/Source/transformer-chatserver\012"

screen -t SSH         8
stuff "cd $HOME/.ssh\012"

screen -t SSH2        9
stuff "cd $HOME/.ssh\012"

select 2
